generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  password String
  age      Int
  city     String
}

model Todo{
  id       Int @default(autoincrement()) @id
  title    String
  description String
  done      Boolean
  userId    Int
  time      DateTime @default(now())
  
}
